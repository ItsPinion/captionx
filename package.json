{
  "name": "captionx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && bun run dev"
  },
  "devDependencies": {
    "turbo": "^2.11.3"
  }
}
